{
  "name": "college-placement-tracker",
  "version": "1.0.0",
  "description": "A role-based college placement tracking system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "selftest": "node --test tests/matchingValidation.test.js",
    "cpp:build": "make -C cpp",
    "cpp:run": "./cpp/tracker",
    "cpp:test": "make -C cpp test",
    "cpp:selftest": "make -C cpp selftest",
    "cpp:bench": "make -C cpp bench",
    "cpp:clean": "make -C cpp clean"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
